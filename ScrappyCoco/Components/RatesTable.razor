@using ScrappyCoco.Services.ExchangeRates;

@inject IExchangeRateService _exchangeRateService
@inject HttpClient Http;
@inject IJSRuntime JS


<MudTable @ref="table" ServerData="ServerReload" Hover="true" Breakpoint="Breakpoint.Sm"
          LoadingProgressColor="Color.Info">
    <ToolBarContent>
        @* <MudText Typo="Typo.h6">Periodic Elements</MudText> *@
        <MudSpacer />
        <MudSpacer />
        <MudDatePicker Label="Date" DateChanged="OnDateChanged" Clearable="true" />
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Currency</MudTh>
        <MudTh>Sell</MudTh>
        <MudTh>Buy</MudTh>
        <MudTh>Middle</MudTh>
        <MudTh>Date</MudTh>
        <MudTh>Calculate</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Currency">1 @SelectedTargetCurrency?.Code =</MudTd>
        <MudTd DataLabel="Buy">@context.Buy</MudTd>
        <MudTd DataLabel="Sell">@context.Sell</MudTd>
        <MudTd DataLabel="Middle">@context.Middle</MudTd>
        <MudTd DataLabel="Date">@context.Date.ToShortDateString()</MudTd>
        <MudTd DataLabel="Calculate">
            <CalculateRate Rate="context.Middle" />
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>


@code {
@using Models;

    [Parameter]
[EditorRequired]
public Currency? SelectedCurrency { get; set; }

[Parameter]
[EditorRequired]
public Currency? SelectedTargetCurrency { get; set; }

// added for tracking currency changes
private Currency? _previousCurrency;
private Currency? _previousTargetCurrency;

private MudTable<ExchangeRate>? table;

private DateTime? searchDate;

private Dictionary<int, int> quantities = [];

/// <summary>
/// If currency changed reload table
/// </summary>
protected override async Task OnParametersSetAsync()
{
    bool hasChanged = false;

    if (SelectedCurrency != _previousCurrency)
    {
        _previousCurrency = SelectedCurrency;
        hasChanged = true;
    }

    if (SelectedTargetCurrency != _previousTargetCurrency)
    {
        _previousTargetCurrency = SelectedTargetCurrency;
        hasChanged = true;
    }

    if (hasChanged)
    {
        await OnCurrencyChanged();
    }
}

/// <summary>
/// Triggered on initial load and on pagination change
/// </summary>
/// <param name="state">State of table (pagination)</param>
/// <param name="token">Cancellation token</param>
/// <returns></returns>
private async Task<TableData<ExchangeRate>> ServerReload(TableState state, CancellationToken token)
{

    if (SelectedCurrency is null || SelectedTargetCurrency is null)
    {
        return new TableData<ExchangeRate>()
        {
            TotalItems = 0,
            Items = []
        }; ;
    }

    var exchangeRateParams = new ExchangeRateParams
    {
        CurrencyForId = SelectedCurrency.Id,
        CurrencyTargetId = SelectedTargetCurrency.Id,
        SearchDate = searchDate,
        PageSize = state.PageSize,
        CurrentPage = state.Page + 1
    };

    var rates = await _exchangeRateService.GetAllRates(exchangeRateParams, token);

    if (rates is null)
    {
        return new TableData<ExchangeRate>()
        {
            TotalItems = 0,
            Items = []
        }; ;
    }

    @* await JS.InvokeVoidAsync("console.log", "State: ", state); *@
    return new TableData<ExchangeRate>()
    {
        TotalItems = rates.TotalCount,
        Items = rates.Items
    };
}

private async Task OnCurrencyChanged()
{
    await ReloadTable();
}

private async Task OnDateChanged(DateTime? value)
{
    searchDate = value;
    await ReloadTable();
}

private async Task ReloadTable()
{
    if (table is not null)
        await table.ReloadServerData();
}
}

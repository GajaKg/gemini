@page "/";
@inject IJSRuntime JS

@using ScrappyCoco.Components
@using ScrappyCoco.Services.Currencies;
@using ScrappyCoco.Enums;
@using MudBlazor.Services;

@inject HttpClient Http
@inject ICurrenciesService _currenciesService

<PageTitle>Exchange Rates</PageTitle>
<h1>Exchange Rates</h1>

@if (initLoading)
{
    <p>Loading...</p>
}
else if (currency is null)
{
    <p>No rates</p>
}
else
{
    <p class="my-2">Select rates</p>
    @if (forCurrencies is not null)
    {
        <div class="mb-4">
            <p>Rates for:</p>
            <div class="d-flex gap-2">
                <CurrencySelector CurrencyList="forCurrencies" ActiveId="selectedForCurrency!.Id"
                                  OnCurrencyClick="(item) => Exchange(CurrencySelectionType.From, item)" />
            </div>
        </div>
    }

    @if (inCurrencies is not null)
    {
        <div class="mb-4">
            <p>Rates in:</p>
            <div class="d-flex gap-2">
                <CurrencySelector CurrencyList="inCurrencies" ActiveId="selectedInCurrency!.Id"
                                  OnCurrencyClick="(item) => Exchange(CurrencySelectionType.To, item)" />
            </div>
        </div>
    }

    <h3>Rates for: @currency?.Name</h3>
    <p>1 @selectedInCurrency?.Code to @selectedForCurrency?.Code </p>

    @if (currency is not null)
    {
        <RatesTable ExchangeRates="currency.ExchangeRates" IsLoading="isLoading" />
    }
}

@code {
@using Models;

CurrencyCode[] ratesForCode = [CurrencyCode.XOF, CurrencyCode.MAD];
CurrencyCode[] ratesInCode = [CurrencyCode.EUR, CurrencyCode.USD];

private Currency? currency;
private List<Currency> forCurrencies = [];
private List<Currency> inCurrencies = [];
private Currency? selectedForCurrency;
private Currency? selectedInCurrency;
private bool isLoading = false;
private bool initLoading = false;

protected override async Task OnInitializedAsync()
{
    initLoading = true;

    try
    {
        var currencies = await _currenciesService.GetAllCurrencies();

        if (currencies is null)
            return;

        forCurrencies = currencies
            .Where(c => ratesForCode.Contains(c.Code))
            .ToList();

        inCurrencies = currencies
            .Where(c => ratesInCode.Contains(c.Code))
            .ToList();

        if (forCurrencies.Count == 0 || inCurrencies.Count == 0)
            return;

        selectedForCurrency = forCurrencies.FirstOrDefault();
        selectedInCurrency = inCurrencies.FirstOrDefault();

        if (selectedForCurrency is null || selectedInCurrency is null) return;

        currency = await _currenciesService.GetCurrencyAndRatesByTargetId(selectedForCurrency.Id, selectedInCurrency.Id);
    }
    catch (Exception ex)
    {
        Console.WriteLine(ex);
    }
    finally
    {
        initLoading = false;
    }

}

private async Task Exchange(CurrencySelectionType selection, Currency selectedCurrency)
{
    if (selection == CurrencySelectionType.From)
    {
        selectedForCurrency = selectedCurrency;
    }
    else
    {
        selectedInCurrency = selectedCurrency;
    }

    isLoading = true;

    try
    {
        if (selectedForCurrency is null || selectedInCurrency is null) return;
        currency = await _currenciesService.GetCurrencyAndRatesByTargetId(selectedForCurrency.Id, selectedInCurrency.Id);
    }
    catch (Exception ex)
    {
        Console.WriteLine(ex);
    }
    finally
    {
        isLoading = false;
    }
}

}

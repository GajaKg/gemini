@page "/";
@inject IJSRuntime JS

@using ScrappyCoco.Components
@using ScrappyCoco.Services.Currencies;
@using ScrappyCoco.Services.ExchangeRates;
@using ScrappyCoco.Enums;

@inject HttpClient Http;
@inject ICurrenciesService _currenciesService;
@inject IExchangeRateService _exchangeRateService;

<PageTitle>Exchange Rates</PageTitle>
<h1>Exchange Rates</h1>

@if (initLoading)
{
    <p>Loading...</p>
}
else if (exchangeRates is null)
{
    <p>No rates</p>
}
else
{
    <p class="my-2">Select rates</p>
    @if (forCurrencies is not null)
    {
        <div class="mb-4">
            <p>Rates for:</p>
            <div class="d-flex gap-2">
                <CurrencySelector CurrencyList="forCurrencies" ActiveId="selectedForCurrency!.Id"
                                  OnCurrencyClick="(item) => Exchange(CurrencySelectionType.From, item)" />
            </div>
        </div>
    }

    @if (targetCurrencies is not null)
    {
        <div class="mb-4">
            <p>Rates in:</p>
            <div class="d-flex gap-2">
                <CurrencySelector CurrencyList="targetCurrencies" ActiveId="selectedTargetCurrency!.Id"
                                  OnCurrencyClick="(item) => Exchange(CurrencySelectionType.To, item)" />
            </div>
        </div>
    }

    <h3>Rates for: @selectedForCurrency?.Name</h3>
    <p>1 @selectedTargetCurrency?.Code to @selectedForCurrency?.Code </p>

    @if (exchangeRates is not null)
    {
        <RatesTable ExchangeRates="exchangeRates" targetCurrencyCode="selectedTargetCurrency?.Code" IsLoading="isLoading" />
    }
}

@code {
@using Models;

CurrencyCode[] ratesForCode = [CurrencyCode.XOF, CurrencyCode.MAD];
CurrencyCode[] ratesTargetCode = [CurrencyCode.EUR, CurrencyCode.USD];

@* private Currency? currency; *@
private PagedResponse<ExchangeRate>? exchangeRates;
private List<Currency> forCurrencies = [];
private List<Currency> targetCurrencies = [];
private Currency? selectedForCurrency;
private Currency? selectedTargetCurrency;
private bool isLoading = false;
private bool initLoading = false;

protected override async Task OnInitializedAsync()
{
    initLoading = true;

    try
    {
        var currencies = await _currenciesService.GetAllCurrencies();

        if (currencies is null)
            return;

        forCurrencies = currencies
            .Where(c => ratesForCode.Contains(c.Code))
            .ToList();

        targetCurrencies = currencies
            .Where(c => ratesTargetCode.Contains(c.Code))
            .ToList();

        if (forCurrencies.Count == 0 || targetCurrencies.Count == 0)
            return;

        selectedForCurrency = forCurrencies.FirstOrDefault();
        selectedTargetCurrency = targetCurrencies.FirstOrDefault();

        if (selectedForCurrency is null || selectedTargetCurrency is null) return;

        @* currency = await _currenciesService.GetCurrencyAndRatesByTargetId(selectedForCurrency.Id, selectedTargetCurrency.Id);
*@
        exchangeRates = await _exchangeRateService.GetAllRates(selectedForCurrency.Id, selectedTargetCurrency.Id);
        await JS.InvokeVoidAsync("console.log", "User data: ", exchangeRates);

    }
    catch (Exception ex)
    {
        Console.WriteLine(ex);
    }
    finally
    {
        initLoading = false;
    }

}

private async Task Exchange(CurrencySelectionType selection, Currency selectedCurrency)
{
    if (selection == CurrencySelectionType.From)
    {
        selectedForCurrency = selectedCurrency;
    }
    else
    {
        selectedTargetCurrency = selectedCurrency;
    }

    isLoading = true;

    try
    {
        if (selectedForCurrency is null || selectedTargetCurrency is null) return;
        exchangeRates = await _exchangeRateService.GetAllRates(selectedForCurrency.Id, selectedTargetCurrency.Id);
    }
    catch (Exception ex)
    {
        Console.WriteLine(ex);
    }
    finally
    {
        isLoading = false;
    }
}

}
